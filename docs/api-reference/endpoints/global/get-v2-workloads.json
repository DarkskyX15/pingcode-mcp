  },
  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "工时主体的类型。当查询参数含有 pilot_id 或 principal_id 时，principal_type 参数必填。例如： 在 `principal_type` 为 `workitem` 时，获取工作项的工时列表，此时要求作用域包括 `pcp:write:pjm:workitem`; 当不传 `principal_type` 时，获取多类型主体的工时列表，此时要求作用域包括 `pcp:write:pjm:workitem`, `pcp:write:ship:idea`, `pcp:write:ship:ticket`, `pcp:write:testhub:testcase`。",
            "enum": [
              "workitem",
              "idea",
              "ticket",
              "testcase"
            ]
          },
          "pilot_id": {
            "type": "string",
            "description": "工时主体所在产品、项目或测试库的id。使用该参数过滤数据时，登记日期查询的起始时间和登记日期查询的结束时间的跨度最大为3个月。"
          },
          "principal_id": {
            "type": "string",
            "description": "工时主体的id。"
          },
          "start_at": {
            "type": "number",
            "description": "登记日期查询的起始时间。开始时间会转换为对应日期的开始时间点。开始时间和结束时间须同时存在。"
          },
          "end_at": {
            "type": "number",
            "description": "登记日期查询的结束时间。结束时间会转换为对应日期的结束时间点。"
          },
          "report_by_id": {
            "type": "string",
            "description": "登记人的 id。"
          }
        }
      }
    }
  },
