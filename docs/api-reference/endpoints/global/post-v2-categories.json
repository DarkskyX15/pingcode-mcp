{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-categories",
  "meta": {
    "name": "创建一个类别",
    "method": "POST",
    "path": "/v2/categories",
    "group": "类别与分组",
    "groupPath": [
      "全局",
      "通用",
      "类别与分组"
    ],
    "area": "全局",
    "tags": [
      "类别与分组"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖 entity_type 对应的作用域"
      ]
    },
    "description": "用于创建一个类别。  \n 需通过 entity_type 指定类别所属实体类型。",
    "summary": "用于创建一个类别。",
    "sourceFile": "src/modules/v2/pingcode/global/common/category/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E7%B1%BB%E5%88%AB"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "类别所属实体类型。例如： 在 `entity_type` 为 `sprint` 时，创建迭代的类别，此时要求作用域包括 `pcp:write:pjm:sprint`；",
            "enum": [
              "sprint",
              "release",
              "testplan",
              "project",
              "library",
              "product"
            ]
          },
          "pilot_id": {
            "type": "string",
            "description": "类别所在的产品、项目或测试库的 id。仅 `entity_type` 为 `sprint`、`release` 或 `testplan` 时有效且必填。"
          },
          "name": {
            "type": "string",
            "description": "类别的名称。"
          },
          "section_id": {
            "type": "string",
            "description": "类别所属分组 id。仅 `entity_type` 为 `sprint`、`release` 或 `testplan` 时有效。"
          }
        },
        "required": [
          "entity_type",
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "entity_type": "sprint",
            "pilot_id": "5eb623f6a70571487ea47000",
            "name": "Category 1",
            "section_id": "634f869a0fd987b7ea320833"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "类别的 id。"
        },
        "url": {
          "type": "string",
          "description": "类别的地址。"
        },
        "pilot": {
          "type": "object",
          "description": "类别所在的产品、项目或测试库的引用结构数据。仅 `entity_type` 为 `sprint`、`release` 或 `testplan` 时返回。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "identifier": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "template_type": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "is_archived": {
              "type": "number",
              "x-inferred-from-example": true
            },
            "is_deleted": {
              "type": "number",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "name": {
          "type": "string",
          "description": "类别的名称。"
        },
        "section": {
          "type": "object",
          "description": "所属分组的引用结构数据。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "required": [
        "id",
        "url",
        "name"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "676a460a0fd987b7ea320887",
          "url": "https://{rest_api_root}/v2/categories/676a460a0fd987b7ea320887?entity_type=sprint",
          "pilot": {
            "id": "5eb623f6a70571487ea47000",
            "url": "https://{rest_api_root}/v2/pjm/projects/5eb623f6a70571487ea47000",
            "identifier": "SCR",
            "name": "Scrum 项目",
            "template_type": "scrum",
