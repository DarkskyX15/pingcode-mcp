{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-entity-properties",
  "meta": {
    "name": "获取实体中的扩展属性列表",
    "method": "GET",
    "path": "/v2/entity_properties",
    "group": "实体扩展属性",
    "groupPath": [
      "全局",
      "通用",
      "实体扩展属性"
    ],
    "area": "全局",
    "tags": [
      "实体扩展属性"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖所属实体的作用域"
      ]
    },
    "description": "用于获取指定实体上的扩展属性列表。",
    "summary": "用于获取指定实体上的扩展属性列表。",
    "sourceFile": "src/modules/v2/pingcode/global/common/entity-property/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E5%AE%9E%E4%BD%93%E4%B8%AD%E7%9A%84%E6%89%A9%E5%B1%95%E5%B1%9E%E6%80%A7%E5%88%97%E8%A1%A8",
    "originalUrl": "/v2/entity_properties?entity_type={entity_type}&entity_id={entity_id}"
  },
  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "实体类型。例如： 在 `entity_type` 为 `workitem` 时，获取工作项的扩展属性列表，此时要求作用域包括 `pcp:read:pjm:workitem`；",
            "enum": [
              "workitem",
              "idea",
              "ticket",
              "testcase",
              "product",
              "project",
              "library",
              "space",
              "page"
            ]
          },
          "entity_id": {
            "type": "string",
            "description": "实体的 id。"
          }
        },
        "required": [
          "entity_type",
          "entity_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "page_index": {
          "type": "number",
          "description": "页码，从 0 开始。"
        },
        "page_size": {
          "type": "number",
          "description": "每页条数。"
        },
        "total": {
          "type": "number",
          "description": "总条数。"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "url": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "property_key": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "value": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "number",
                    "x-inferred-from-example": true
                  },
                  "risk": {
                    "type": "string",
                    "x-inferred-from-example": true
                  }
                },
                "x-inferred-from-example": true
              }
            },
            "x-inferred-from-example": true
          },
          "description": "扩展属性全量结构数据的数组。",
          "x-inferred-from-example": true
        }
      },
      "required": [
        "page_index",
        "page_size",
        "total",
        "values"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "page_index": 0,
          "page_size": 30,
          "total": 1,
          "values": [
            {
              "id": "entity_property_key_a",
              "url": "https://{rest_api_root}/v2/entity_properties/entity_property_key_a?entity_type=workitem&entity_id=6efca131b06329c524cdd2fb",
              "property_key": "entity_property_key_a",
              "value": {
                "score": 95,
                "risk": "low"
              }
            }
          ]
        }
      }
    ]
  }
}
