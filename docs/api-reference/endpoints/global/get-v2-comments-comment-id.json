{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-comments-comment-id",
  "meta": {
    "name": "获取一条评论",
    "method": "GET",
    "path": "/v2/comments/{comment_id}",
    "group": "评论",
    "groupPath": [
      "全局",
      "通用",
      "评论"
    ],
    "area": "全局",
    "tags": [
      "评论"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖评论所属主体的作用域"
      ]
    },
    "description": "用于按 id 获取一条评论。  \n 需通过 principal_type 指定所属主体。",
    "summary": "用于按 id 获取一条评论。",
    "sourceFile": "src/modules/v2/pingcode/global/common/comment/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E6%9D%A1%E8%AF%84%E8%AE%BA",
    "originalUrl": "/v2/comments/{comment_id}?principal_type={principal_type}&principal_id={principal_id}"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "comment_id": {
            "type": "string",
            "description": "评论的 id。"
          }
        },
        "required": [
          "comment_id"
        ]
      }
    },
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "评论主体的类型。例如： 在 `principal_type` 为 `workitem` 时，获取工作项的评论，此时要求作用域包括 `pcp:read:pjm:workitem`； 在 `principal_type` 为 `workitem_review（工作项评审）` 时，获取工作项评审的评论，此时要求作用域包括 `pcp:read:pjm:project`；",
            "enum": [
              "workitem",
              "workitem_review",
              "testrun",
              "testcase",
              "testcase_review",
              "idea",
              "idea_review",
              "ticket",
              "page"
            ]
          },
          "principal_id": {
            "type": "string",
            "description": "评论主体的 id。"
          }
        },
        "required": [
          "principal_type"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "评论的 id。"
        },
        "url": {
          "type": "string",
          "description": "评论的资源地址。"
        },
        "content": {
          "type": "string",
          "description": "评论的内容。被删除的评论 content 字段会被置空，is_deleted 字段为 1。"
        },
        "attachment_count": {
          "type": "number",
          "description": "评论的附件数量。"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "url": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "title": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "size": {
                "type": "number",
                "x-inferred-from-example": true
              },
              "type": {
                "type": "string",
                "x-inferred-from-example": true
              }
            },
            "x-inferred-from-example": true
          },
          "description": "评论的附件列表。",
          "x-inferred-from-example": true
        },
        "is_reply_comment": {
          "type": "number",
          "description": "是否是回复评论。",
          "enum": [
            0,
            1
          ]
        },
        "reply_comment": {
          "type": "object",
          "description": "被回复的评论。"
        },
        "created_at": {
          "type": "number",
          "description": "评论的创建时间。"
        },
        "created_by": {
          "type": "object",
          "description": "评论的创建人。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "display_name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "avatar": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "is_deleted": {
          "type": "number",
          "description": "评论是否被删除。",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "id",
        "url",
        "content",
        "attachment_count",
        "attachments",
        "is_reply_comment",
        "reply_comment",
        "created_at",
        "created_by",
        "is_deleted"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "59f72dfaeadb5b5197b7da6d",
          "url": "https://{rest_api_root}/v2/comments/59f72dfaeadb5b5197b7da6d?principal_type=workitem&principal_id=5edca524cad2fa1125cb0630",
          "content": "这是一个工作项评论",
          "attachment_count": 1,
          "attachments": [
            {
              "id": "5da588ca84c7377a5d327e6d",
              "url": "https://{rest_api_root}/v2/attachments/5da588ca84c7377a5d327e6d?principal_type=workitem&principal_id=5edca524cad2fa1125cb0630&comment_id=59f72dfaeadb5b5197b7da6d",
              "title": "这是一个代码片段",
              "size": 16,
              "type": "snippet"
            }
          ],
          "is_reply_comment": 0,
          "reply_comment": null,
          "created_at": 1565255712,
          "created_by": {
            "id": "a0417f68e846aae315c85d24643678a9",
            "url": "https://{rest_api_root}/v2/directory/users/a0417f68e846aae315c85d24643678a9",
            "name": "john",
            "display_name": "John",
            "avatar": "https://s3.amazonaws.com/bucket/b46ef40c-e22e-4ecf-a599-cace9fba839a_160x160.png"
          },
          "is_deleted": 0
        }
      }
    ]
  }
}
