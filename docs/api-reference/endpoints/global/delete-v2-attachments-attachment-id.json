{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "delete-v2-attachments-attachment-id",
  "meta": {
    "name": "删除一个附件",
    "method": "DELETE",
    "path": "/v2/attachments/{attachment_id}",
    "group": "附件",
    "groupPath": [
      "全局",
      "通用",
      "附件"
    ],
    "area": "全局",
    "tags": [
      "附件"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖附件所属主体的作用域"
      ]
    },
    "description": "用于按 id 删除一个附件。  \n 需通过 principal_type 指定所属主体。  \n 删除所属主体的评论附件时还需传 comment_id。",
    "summary": "用于按 id 删除一个附件。",
    "sourceFile": "src/modules/v2/pingcode/global/common/attachment/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%A0%E9%99%A4%E4%B8%80%E4%B8%AA%E9%99%84%E4%BB%B6",
    "originalUrl": "/v2/attachments/{attachment_id}?principal_type={principal_type}&principal_id={principal_id}"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string",
            "description": "附件的 id。"
          }
        },
        "required": [
          "attachment_id"
        ]
      }
    },
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "附件主体的类型。例如： 在 `principal_type` 为 `workitem` 时，删除工作项的附件，此时要求作用域包括 `pcp:write:pjm:workitem`； 在 `principal_type` 为 `workitem_review（工作项评审）` 时，删除工作项评审的附件，此时要求作用域包括 `pcp:write:pjm:project`；",
            "enum": [
              "workitem",
              "workitem_review",
              "testcase",
              "testcase_review",
              "testrun",
              "idea",
              "idea_review",
              "ticket",
              "page"
            ]
          },
          "principal_id": {
            "type": "string",
            "description": "附件主体的 id。"
          },
          "comment_id": {
            "type": "string",
            "description": "附件主体的评论 id。当需要删除评论附件时，需要传入该参数。"
          }
        },
        "required": [
          "principal_type",
          "principal_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "附件的 id。"
        },
        "url": {
          "type": "string",
          "description": "附件的资源地址。"
        },
        "title": {
          "type": "string",
          "description": "附件的标题。"
        },
        "size": {
          "type": "number",
          "description": "附件的大小。"
        },
        "type": {
          "type": "string",
          "description": "附件的类型。",
          "enum": [
            "file",
            "snippet"
          ]
        },
        "file_type": {
          "type": "string",
          "description": "文件的类型。",
          "enum": [
            "image",
            "other"
          ]
        },
        "ext": {
          "type": "string",
          "description": "文件的扩展名。"
        },
        "download_url": {
          "type": "string",
          "description": "文件的下载地址。"
        },
        "created_at": {
          "type": "number",
          "description": "附件的创建时间。"
        },
        "created_by": {
          "type": "object",
          "description": "附件的创建人。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "display_name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "avatar": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "size",
        "type",
        "file_type",
        "ext",
        "download_url",
        "created_at",
        "created_by"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "5da588ca84c7377a5d327e6c",
          "url": "https://{rest_api_root}/v2/attachments/5da588ca84c7377a5d327e6c?principal_type=workitem&principal_id=5edca524cad2fa1125cb0630",
          "title": "这是一个图片类型的附件",
          "size": 1024,
          "type": "file",
          "file_type": "image",
          "ext": "png",
          "download_url": "https://s3.amazonaws.com/bucket/b46ef40c-e22e-4ecf-a599-cace9fba839a.png",
          "created_at": 1583290347,
          "created_by": {
            "id": "a0417f68e846aae315c85d24643678a9",
            "url": "https://{rest_api_root}/v2/directory/users/a0417f68e846aae315c85d24643678a9",
            "name": "john",
            "display_name": "John",
            "avatar": "https://s3.amazonaws.com/bucket/b46ef40c-e22e-4ecf-a599-cace9fba839a_160x160.png"
          }
        }
      }
    ]
  }
}
