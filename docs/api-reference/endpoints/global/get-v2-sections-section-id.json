{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-sections-section-id",
  "meta": {
    "name": "获取一个分组",
    "method": "GET",
    "path": "/v2/sections/{section_id}",
    "group": "类别与分组",
    "groupPath": [
      "全局",
      "通用",
      "类别与分组"
    ],
    "area": "全局",
    "tags": [
      "类别与分组"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖 entity_type 对应的作用域"
      ]
    },
    "description": "用于按 id 获取分组全量信息。",
    "summary": "用于按 id 获取分组全量信息。",
    "sourceFile": "src/modules/v2/pingcode/global/common/section/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA%E5%88%86%E7%BB%84",
    "originalUrl": "/v2/sections/{section_id}?entity_type={entity_type}"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string",
            "description": "分组的 id。"
          }
        },
        "required": [
          "section_id"
        ]
      }
    },
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "分组所属实体类型。例如： 在 `entity_type` 为 `sprint` 时，获取迭代的分组，此时要求作用域包括 `pcp:read:pjm:sprint`；",
            "enum": [
              "sprint",
              "release",
              "testplan"
            ]
          }
        },
        "required": [
          "entity_type"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "分组的 id。"
        },
        "url": {
          "type": "string",
          "description": "分组的地址。"
        },
        "pilot": {
          "type": "object",
          "description": "分组所在的产品、项目或测试库的引用结构数据。"
        },
        "name": {
          "type": "string",
          "description": "分组的名称。"
        }
      },
      "required": [
        "id",
        "url",
        "pilot",
        "name"
      ]
    }
  }
}
