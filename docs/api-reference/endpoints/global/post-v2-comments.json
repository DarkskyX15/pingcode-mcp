{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-comments",
  "meta": {
    "name": "创建一条评论",
    "method": "POST",
    "path": "/v2/comments",
    "group": "评论",
    "groupPath": [
      "全局",
      "通用",
      "评论"
    ],
    "area": "全局",
    "tags": [
      "评论"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖评论所属主体的作用域"
      ]
    },
    "description": "用于向指定主体创建一条评论。  \n 需通过 principal_type 指定所属主体。",
    "summary": "用于向指定主体创建一条评论。",
    "sourceFile": "src/modules/v2/pingcode/global/common/comment/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E6%9D%A1%E8%AF%84%E8%AE%BA"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "评论主体的类型。例如： 在 `principal_type` 为 `workitem` 时，创建工作项的评论，此时要求作用域包括 `pcp:write:pjm:workitem`； 在 `principal_type` 为 `workitem_review（工作项评审）` 时，创建工作项评审的评论，此时要求作用域包括 `pcp:write:pjm:project`；",
            "enum": [
              "workitem",
              "workitem_review",
              "testrun",
              "testcase",
              "testcase_review",
              "idea",
              "idea_review",
              "ticket",
              "page"
            ]
          },
          "principal_id": {
            "type": "string",
            "description": "评论主体的 id。"
          },
          "content": {
            "type": "string",
            "description": "评论的内容。"
          },
          "reply_comment_id": {
            "type": "string",
            "description": "被回复评论的 id。"
          },
          "created_at": {
            "type": "number",
            "description": "评论的创建时间。"
          },
          "created_by": {
            "type": "string",
            "description": "评论的创建人。"
          }
        },
        "required": [
          "principal_type",
          "content"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "principal_type": "workitem",
            "principal_id": "5edca524cad2fa1125cb0630",
            "content": "这是一个工作项评论",
            "created_at": 1565255712,
            "created_by": "a0417f68e846aae315c85d24643678a9"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "评论的 id。"
        },
        "url": {
          "type": "string",
          "description": "评论的资源地址。"
        },
        "content": {
          "type": "string",
          "description": "评论的内容。"
        },
        "attachment_count": {
          "type": "number",
          "description": "评论的附件数量。"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "评论的附件列表。"
        },
        "is_reply_comment": {
          "type": "number",
          "description": "是否是回复评论。",
          "enum": [
            0,
            1
          ]
        },
        "reply_comment": {
          "type": "object",
          "description": "被回复的评论。"
        },
        "created_at": {
          "type": "number",
          "description": "评论的创建时间。"
        },
        "created_by": {
          "type": "object",
          "description": "评论的创建人。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "display_name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "avatar": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "is_deleted": {
          "type": "number",
          "description": "评论是否被删除。",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "id",
        "url",
        "content",
        "attachment_count",
        "attachments",
        "is_reply_comment",
        "reply_comment",
        "created_at",
        "created_by",
        "is_deleted"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "59f72dfaeadb5b5197b7da6d",
          "url": "https://{rest_api_root}/v2/comments/59f72dfaeadb5b5197b7da6d?principal_type=workitem&principal_id=5edca524cad2fa1125cb0630",
          "content": "这是一个工作项评论",
          "attachment_count": 0,
          "attachments": [],
          "is_reply_comment": 0,
          "reply_comment": null,
          "created_at": 1565255712,
          "created_by": {
            "id": "a0417f68e846aae315c85d24643678a9",
            "url": "https://{rest_api_root}/v2/directory/users/a0417f68e846aae315c85d24643678a9",
            "name": "john",
            "display_name": "John",
            "avatar": "https://s3.amazonaws.com/bucket/b46ef40c-e22e-4ecf-a599-cace9fba839a_160x160.png"
          },
          "is_deleted": 0
        }
      }
    ]
  }
}
