            "type": "string",
            "description": "评审内容的 id。"
          },
          "principal_type": {
            "type": "string",
            "description": "评审主体的类型。例如： 在 `principal_type` 为 `workitem` 时，向工作项评审中添加评审内容，此时要求作用域包括 `pcp:write:pjm:project`；",
            "enum": [
              "idea",
              "workitem",
              "testcase"
            ]
          }
        },
        "required": [
          "principal_id",
          "principal_type"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "principal_id": "63bb744514bd13c9def24ceb",
            "principal_type": "idea"
          }
        }
      ]
    }
  },
