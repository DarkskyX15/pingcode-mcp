        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "操作状态。",
            "enum": [
              "success",
              "failure"
            ]
          },
          "id": {
            "type": "string",
            "description": "企业成员 id。"
          },
          "message": {
            "type": "string",
            "description": "操作失败时的错误信息。"
          }
        },
        "required": [
