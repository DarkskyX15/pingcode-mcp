          },
          "property_name": {
            "type": "string",
            "description": "需要设置的企业成员属性名，目前仅支持：status（可选值为：enabled、disabled）。"
          },
          "property_value": {
            "type": "string",
            "description": "需要设置的企业成员属性值。"
          }
        },
        "required": [
          "ids",
          "property_name",
          "property_value"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "ids": [
              "a0417f68e846aae315c85d24643678a9"
            ],
            "property_name": "status",
            "property_value": "enabled"
          }
        }
      ]
    }
  },
  "response": {
