  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "评审的标题。"
          },
          "pilot_id": {
            "type": "string",
            "description": "评审主体所在产品、项目或测试库的 id。"
          },
          "principal_type": {
            "type": "string",
            "description": "评审主体的类型。例如： 在 `principal_type` 为 `workitem` 时，创建工作项的评审，此时要求作用域包括 `pcp:write:pjm:project`；",
            "enum": [
              "idea",
              "workitem",
              "testcase"
            ]
          },
          "description": {
            "type": "string",
            "description": "评审的描述。"
          }
        },
        "required": [
          "title",
          "pilot_id",
          "principal_type"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "title": "这是一个评审",
            "pilot_id": "63bb744314bd13c9def24cb4",
            "principal_type": "idea",
            "description": "这是一个评审的描述"
          }
        }
      ]
    }
  },
