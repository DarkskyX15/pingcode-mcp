      "scopes": [
        "依赖评审所属主体的作用域"
      ]
    },
    "description": "用于创建一个评审。  \n 需通过 principal_type 指定所属主体。",
    "summary": "用于创建一个评审。",
    "sourceFile": "src/modules/v2/pingcode/global/common/review/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E8%AF%84%E5%AE%A1"
