{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-attachments-2",
  "meta": {
    "name": "上传一个文件",
    "method": "POST",
    "path": "/v2/attachments",
    "group": "附件",
    "groupPath": [
      "全局",
      "通用",
      "附件"
    ],
    "area": "全局",
    "tags": [
      "附件"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖附件所属主体的作用域"
      ]
    },
    "description": "用于向指定主体上传一个文件。  \n 需通过 principal_type 指定所属主体。  \n 向所属主体的评论上传时还需传 comment_id。",
    "summary": "用于向指定主体上传一个文件。",
    "sourceFile": "src/modules/v2/pingcode/global/common/attachment/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E4%B8%8A%E4%BC%A0%E4%B8%80%E4%B8%AA%E6%96%87%E4%BB%B6",
    "originalUrl": "/v2/attachments?principal_type={principal_type}&principal_id={principal_id}"
  },
  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "附件主体的类型。例如： 在 `principal_type` 为 `workitem` 时，向工作项上传文件，此时要求作用域包括 `pcp:write:pjm:workitem`； 在 `principal_type` 为 `workitem_review（工作项评审）` 时，向工作项评审上传文件，此时要求作用域包括 `pcp:write:pjm:project`；",
            "enum": [
              "workitem",
              "workitem_review",
              "testcase",
              "testcase_review",
              "testrun",
              "idea",
              "idea_review",
              "ticket",
              "page"
            ]
          },
          "principal_id": {
            "type": "string",
            "description": "附件主体的 id。"
          },
          "comment_id": {
            "type": "string",
            "description": "附件主体的评论 id。当需要向附件主体的评论上传文件或者代码段时，需要传入该参数。"
          }
        },
        "required": [
          "principal_type",
          "principal_id"
        ]
      }
    },
    "headers": {
      "schema": {
        "type": "object",
        "properties": {
          "content-type": {
            "type": "string",
            "description": "`multipart/form-data`。"
          }
        },
        "required": [
          "content-type"
        ]
      }
    },
    "body": {
      "required": true,
      "contentType": "multipart/form-data",
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "description": "要上传的文件。"
          }
        },
        "required": [
          "file"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "url": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "title": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "size": {
          "type": "number",
          "x-inferred-from-example": true
        },
        "type": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "file_type": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "ext": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "download_url": {
          "type": "string",
          "x-inferred-from-example": true
        },
        "created_at": {
          "type": "number",
          "x-inferred-from-example": true
        },
        "created_by": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "display_name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "avatar": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "x-inferred-from-example": true
    },
