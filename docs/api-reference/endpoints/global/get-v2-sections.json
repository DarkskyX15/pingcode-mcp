{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-sections",
  "meta": {
    "name": "获取分组列表",
    "method": "GET",
    "path": "/v2/sections",
    "group": "类别与分组",
    "groupPath": [
      "全局",
      "通用",
      "类别与分组"
    ],
    "area": "全局",
    "tags": [
      "类别与分组"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖 entity_type 对应的作用域"
      ]
    },
    "description": "用于分页获取某 Pilot 下指定实体类型的分组。",
    "summary": "用于分页获取某 Pilot 下指定实体类型的分组。",
    "sourceFile": "src/modules/v2/pingcode/global/common/section/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E5%88%86%E7%BB%84%E5%88%97%E8%A1%A8",
    "originalUrl": "/v2/sections?entity_type={entity_type}&pilot_id={pilot_id}"
  },
  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "分组所属实体类型。例如： 在 `entity_type` 为 `sprint` 时，获取迭代的分组，此时要求作用域包括 `pcp:read:pjm:sprint`；",
            "enum": [
              "sprint",
              "release",
              "testplan"
            ]
          },
          "pilot_id": {
            "type": "string",
            "description": "分组所在的产品、项目或测试库的 id。"
          }
        },
        "required": [
          "entity_type",
          "pilot_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "number",
          "description": "每页条数。"
        },
        "page_index": {
          "type": "number",
          "description": "页码，从 0 开始。"
        },
        "total": {
          "type": "number",
          "description": "总条数。"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "分组全量结构数据的数组。"
        }
      },
      "required": [
        "page_size",
        "page_index",
        "total",
        "values"
      ]
    }
  }
}
