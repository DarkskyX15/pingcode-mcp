  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "评论主体的类型。例如： 在 `principal_type` 为 `workitem` 时，获取工作项的评论列表，此时要求作用域包括 `pcp:read:pjm:workitem`； 在 `principal_type` 为 `workitem_review（工作项评审）` 时，获取工作项评审的评论列表，此时要求作用域包括 `pcp:read:pjm:project`；",
            "enum": [
              "workitem",
              "workitem_review",
              "testrun",
              "testcase",
              "testcase_review",
              "idea",
              "idea_review",
              "ticket",
              "page"
            ]
          },
          "principal_id": {
            "type": "string",
            "description": "评论主体的 id。"
          }
        },
        "required": [
          "principal_type"
        ]
      }
    }
