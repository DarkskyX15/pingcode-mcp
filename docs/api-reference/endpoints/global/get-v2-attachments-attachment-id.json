{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-attachments-attachment-id",
  "meta": {
    "name": "获取一个附件",
    "method": "GET",
    "path": "/v2/attachments/{attachment_id}",
    "group": "附件",
    "groupPath": [
      "全局",
      "通用",
      "附件"
    ],
    "area": "全局",
    "tags": [
      "附件"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖附件所属主体的作用域"
      ]
    },
    "description": "用于按 id 获取一个附件，支持文件、代码段、链接和页面。  \n 需通过 principal_type 指定所属主体。  \n 获取所属主体的评论附件时还需传 comment_id。",
    "summary": "用于按 id 获取一个附件，支持文件、代码段、链接和页面。",
    "sourceFile": "src/modules/v2/pingcode/global/common/attachment/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA%E9%99%84%E4%BB%B6",
    "originalUrl": "/v2/attachments/{attachment_id}?principal_type={principal_type}&principal_id={principal_id}"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string",
            "description": "附件的 id。"
          }
        },
        "required": [
          "attachment_id"
        ]
      }
    },
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "附件主体的类型。例如： 在 `principal_type` 为 `workitem` 时，获取工作项的附件，此时要求作用域包括 `pcp:read:pjm:workitem`； 在 `principal_type` 为 `deliverable_target` 时，获取交付目标的附件，此时要求作用域包括 `pcp:read:pjm:project`； 在 `principal_type` 为 `workitem_review（工作项评审）` 时，获取工作项评审的附件，此时要求作用域包括 `pcp:read:pjm:project`；",
            "enum": [
              "workitem",
              "workitem_review",
              "deliverable_target",
              "testcase",
              "testcase_review",
              "testrun",
              "idea",
              "idea_review",
              "ticket",
              "page"
            ]
          },
          "principal_id": {
            "type": "string",
            "description": "附件主体的 id。"
          },
          "comment_id": {
            "type": "string",
            "description": "附件主体的评论 id。当需要获取评论附件时，需要传入该参数。"
          }
        },
        "required": [
          "principal_type",
          "principal_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "附件的 id。"
        },
        "url": {
          "type": "string",
          "description": "附件的资源地址。"
        },
        "title": {
          "type": "string",
          "description": "附件的标题。"
        },
        "size": {
          "type": "number",
          "description": "附件的大小。"
        },
        "type": {
          "type": "string",
          "description": "附件的类型。",
          "enum": [
            "file",
            "snippet",
            "link",
            "page"
          ]
        },
        "file_type": {
          "type": "string",
          "description": "文件的类型。当附件的类型为 `file` 时返回。",
          "enum": [
            "image",
            "other"
          ]
        },
        "ext": {
          "type": "string",
          "description": "文件的扩展名。当附件的类型为 `file` 时返回。"
        },
        "download_url": {
          "type": "string",
          "description": "文件的下载地址。当附件的类型为 `file` 时返回。"
        },
        "format": {
          "type": "string",
          "description": "代码的格式。当附件的类型为 `snippet` 时返回。",
          "enum": [
            "clike",
            "css",
            "dart",
            "django",
            "dockerfile",
            "go",
            "markdown",
            "nginx",
            "python",
            "php",
            "shell",
            "sql",
            "swift",
            "html",
            "javascript",
            "jsx",
            "pascal",
            "sass",
            "stylus",
            "vue",
            "yaml",
            "haskell"
          ]
        },
        "content": {
          "type": "string",
          "description": "代码的内容。当附件的类型为 `snippet` 时返回。"
        },
        "line": {
          "type": "number",
          "description": "代码的行数。当附件的类型为 `snippet` 时返回。"
        },
        "link_url": {
          "type": "string",
          "description": "链接的地址。当附件的类型为 `link` 时返回。"
        },
        "short_id": {
          "type": "string",
          "description": "页面的短 id。当附件的类型为 `page` 时返回。"
        },
        "html_url": {
          "type": "string",
          "description": "页面的访问地址。当附件的类型为 `page` 时返回。"
        },
        "created_at": {
          "type": "number",
          "description": "附件的创建时间。"
        },
        "created_by": {
          "type": "object",
          "description": "附件的创建人。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "display_name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "avatar": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "size",
        "type",
        "created_at",
        "created_by"
      ]
    },
    "examples": [
