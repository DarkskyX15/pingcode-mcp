        "依赖评审所属主体的作用域"
      ]
    },
    "description": "用于分页获取评审列表。  \n 需通过 principal_type 与 pilot_id 指定所属产品、项目或测试库。",
    "summary": "用于分页获取评审列表。",
    "sourceFile": "src/modules/v2/pingcode/global/common/review/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E8%AF%84%E5%AE%A1%E5%88%97%E8%A1%A8",
    "originalUrl": "/v2/reviews?principal_type={principal_type}&pilot_id={pilot_id}"
  },
  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "principal_type": {
            "type": "string",
            "description": "评审主体的类型。例如： 在 `principal_type` 为 `workitem` 时，获取工作项的评审列表，此时要求作用域包括 `pcp:read:pjm:project`；",
            "enum": [
              "workitem",
              "testcase",
              "idea"
            ]
          },
          "pilot_id": {
            "type": "string",
            "description": "评审主体所在产品、项目或测试库的 id。"
          },
          "status": {
            "type": "string",
            "description": "评审的状态。",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "repealed"
            ]
          }
        },
        "required": [
          "principal_type",
          "pilot_id"
        ]
      }
    }
  },
