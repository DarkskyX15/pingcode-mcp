{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "delete-v2-entity-properties-property-id",
  "meta": {
    "name": "在实体中移除一个扩展属性",
    "method": "DELETE",
    "path": "/v2/entity_properties/{property_id}",
    "group": "实体扩展属性",
    "groupPath": [
      "全局",
      "通用",
      "实体扩展属性"
    ],
    "area": "全局",
    "tags": [
      "实体扩展属性"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖所属实体的作用域"
      ]
    },
    "description": "用于移除指定实体上的一个扩展属性。",
    "summary": "用于移除指定实体上的一个扩展属性。",
    "sourceFile": "src/modules/v2/pingcode/global/common/entity-property/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%9C%A8%E5%AE%9E%E4%BD%93%E4%B8%AD%E7%A7%BB%E9%99%A4%E4%B8%80%E4%B8%AA%E6%89%A9%E5%B1%95%E5%B1%9E%E6%80%A7",
    "originalUrl": "/v2/entity_properties/{property_id}?entity_type={entity_type}&entity_id={entity_id}"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "扩展属性的 id 或 property_key。"
          }
        },
        "required": [
          "property_id"
        ]
      }
    },
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "实体类型。例如： 在 `entity_type` 为 `workitem` 时，移除工作项的扩展属性，此时要求作用域包括 `pcp:write:pjm:workitem`；",
            "enum": [
              "workitem",
              "idea",
              "ticket",
              "testcase",
              "product",
              "project",
              "library",
              "space",
              "page"
            ]
          },
          "entity_id": {
            "type": "string",
            "description": "实体的 id。"
          }
        },
        "required": [
          "entity_type",
          "entity_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "属性 id。"
        },
        "property_key": {
          "type": "string",
          "description": "属性键。用于显示在实体的 `entity_properties` 属性中。"
        },
        "url": {
          "type": "string",
          "description": "属性资源地址。"
        },
        "value": {
          "type": "object",
          "description": "移除前的属性值。",
          "properties": {
            "score": {
              "type": "number",
              "x-inferred-from-example": true
            },
            "risk": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "required": [
        "id",
        "property_key",
        "url",
        "value"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "entity_property_key_a",
          "url": "https://{rest_api_root}/v2/entity_properties/entity_property_key_a?entity_type=workitem&entity_id=6efca131b06329c524cdd2fb",
          "property_key": "entity_property_key_a",
          "value": {
            "score": 95,
            "risk": "low"
          }
        }
      }
    ]
  }
}
