{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-sections",
  "meta": {
    "name": "创建一个分组",
    "method": "POST",
    "path": "/v2/sections",
    "group": "类别与分组",
    "groupPath": [
      "全局",
      "通用",
      "类别与分组"
    ],
    "area": "全局",
    "tags": [
      "类别与分组"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "依赖 entity_type 对应的作用域"
      ]
    },
    "description": "用于创建一个分组。  \n 需通过 entity_type 指定分组所属实体类型。",
    "summary": "用于创建一个分组。",
    "sourceFile": "src/modules/v2/pingcode/global/common/section/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E5%88%86%E7%BB%84"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "分组所属实体类型。例如： 在 `entity_type` 为 `sprint` 时，创建迭代的分组，此时要求作用域包括 `pcp:write:pjm:sprint`；",
            "enum": [
              "sprint",
              "release",
              "testplan"
            ]
          },
          "pilot_id": {
            "type": "string",
            "description": "分组所在的产品、项目或测试库的 id。"
          },
          "name": {
            "type": "string",
            "description": "分组的名称。"
          }
        },
        "required": [
          "entity_type",
          "pilot_id",
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "entity_type": "sprint",
            "pilot_id": "5eb623f6a70571487ea47000",
            "name": "Section 1"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "分组的 id。"
        },
        "url": {
          "type": "string",
          "description": "分组的地址。"
        },
        "pilot": {
          "type": "object",
          "description": "分组所在的产品、项目或测试库的引用结构数据。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "identifier": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "template_type": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "is_archived": {
              "type": "number",
              "x-inferred-from-example": true
            },
            "is_deleted": {
              "type": "number",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "name": {
          "type": "string",
          "description": "分组的名称。"
        }
      },
      "required": [
        "id",
        "url",
        "pilot",
        "name"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "634f869a0fd987b7ea320833",
          "url": "https://{rest_api_root}/v2/sections/634f869a0fd987b7ea320833?entity_type=sprint",
          "pilot": {
            "id": "5eb623f6a70571487ea47000",
            "url": "https://{rest_api_root}/v2/pjm/projects/5eb623f6a70571487ea47000",
            "identifier": "SCR",
            "name": "Scrum 项目",
            "template_type": "scrum",
            "is_archived": 0,
            "is_deleted": 0
          },
          "name": "Section 1"
        }
      }
    ]
  }
}
