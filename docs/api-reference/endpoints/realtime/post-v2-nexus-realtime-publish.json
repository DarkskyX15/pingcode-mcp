      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "channel": "workitem-updated",
            "payload": {
              "workitemId": "xxx",
              "field": "title"
            },
            "extension_key": "workitem-panel",
            "extension_data": {
              "workitem": {
                "id": "xxx"
              }
            },
            "options": {
              "scope": "self"
