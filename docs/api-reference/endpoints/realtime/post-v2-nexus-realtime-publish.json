              "workitem": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "x-inferred-from-example": true
                  }
                },
                "x-inferred-from-example": true
              }
            },
            "x-inferred-from-example": true
          },
          "options": {
            "type": "object",
            "description": "发布行为的配置项。",
            "properties": {
              "scope": {
                "type": "string",
                "description": "消息广播的作用范围，默认值为 `self`。",
                "enum": [
                  "self",
                  "global",
                  "token",
                  "context"
                ]
              },
              "token": {
                "type": "string",
                "description": "鉴权 Token，仅在 `scope = token` 时传入；可通过`签发实时消息令牌`获取。"
              },
              "context": {
                "type": "string",
                "description": "业务实体上下文，仅在 `scope = context` 时传入。",
                "enum": [
                  "project",
                  "workitem",
                  "sprint",
                  "product",
                  "idea",
                  "ticket",
                  "space",
                  "page",
                  "library",
                  "testcase",
                  "testplan",
                  "baseline",
                  "release",
                  "plan",
                  "widget",
                  "dashboard",
                  "entry"
                ]
              }
            }
          }
