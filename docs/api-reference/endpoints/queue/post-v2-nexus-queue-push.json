{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-nexus-queue-push",
  "meta": {
    "name": "推送消息到异步队列",
    "method": "POST",
    "path": "/v2/nexus/queue/push",
    "group": "Queue",
    "groupPath": [
      "异步消息队列",
      "Queue"
    ],
    "area": "异步消息队列",
    "tags": [
      "Queue"
    ],
    "listed": false,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:async:app"
      ]
    },
    "description": "将一条或多条 payload 推入异步队列，调用只保证入队，不等待消费者执行。参考 [queue.push](https://open.pingcode.com/reference/functions/async/queue#push)。",
    "summary": "将一条或多条 payload 推入异步队列，调用只保证入队，不等待消费者执行。参考 queue.push。",
    "sourceFile": "src/modules/v2/nexus/async/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E6%8E%A8%E9%80%81%E6%B6%88%E6%81%AF%E5%88%B0%E5%BC%82%E6%AD%A5%E9%98%9F%E5%88%97"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "queue_key": {
            "type": "string",
            "description": "队列名，必须与 manifest 中某个 `async.queues` 条目的 `key` 一致。"
          },
          "payload": {
            "type": "array",
            "description": "payload 数组；数组中的每一项会原样出现在消费者收到的 `task.payload`。单次推送条数为 `1` ~ `32`。",
            "items": {
              "type": "object",
              "properties": {
                "imageId": {
                  "type": "string",
                  "x-inferred-from-example": true
                }
              },
              "x-inferred-from-example": true
            },
            "x-inferred-from-example": true
          },
          "options": {
            "type": "object",
            "description": "异步队列推送选项。",
            "properties": {
              "delay": {
                "type": "number",
                "description": "延时投递的秒数。入队后至少延迟该秒数才可被消费；不传或传 `0` 表示尽快投递；取值范围为 `0` ~ `1800`。批量推送时对本次所有任务生效。"
              }
            }
          }
        },
        "required": [
          "queue_key",
          "payload"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "queue_key": "image-processing",
            "payload": [
              {
                "imageId": "img-1"
              }
            ],
            "options": {
              "delay": 10
            }
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "x-inferred-from-example": true
        }
      },
      "x-inferred-from-example": true
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "job_id": "job-id-1"
        }
      }
    ]
  }
}
