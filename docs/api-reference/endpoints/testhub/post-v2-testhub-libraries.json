              },
              "entity_property_key_b": {
                "type": "string",
                "x-inferred-from-example": true
              }
            },
            "x-inferred-from-example": true
          }
        },
        "required": [
          "name",
          "identifier"
        ],
        "x-inferred-from-example": true
      },
