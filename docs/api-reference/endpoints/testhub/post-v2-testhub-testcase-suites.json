        "properties": {
          "library_id": {
            "type": "string",
            "description": "测试库的 id。"
          },
          "name": {
            "type": "string",
            "description": "测试模块名称。测试模块为树形结构，同一层次下的名称不能重复。"
          },
          "parent_id": {
            "type": "string",
            "description": "父测试模块的 id。"
          }
        },
        "required": [
          "library_id",
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "library_id": "5eb623f6a70571487ea47000",
            "name": "登录",
            "parent_id": "5eb623f6a70571487ea46999"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "用例模块的 id。"
        },
        "url": {
          "type": "string",
          "description": "用例模块的资源地址。"
        },
        "library": {
          "type": "object",
          "description": "所属测试库的引用结构数据。",
          "properties": {
