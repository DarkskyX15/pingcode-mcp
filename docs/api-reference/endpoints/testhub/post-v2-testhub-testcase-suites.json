        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:testhub:library"
      ]
    },
    "description": "用于在测试库中创建一个用例模块。",
    "summary": "用于在测试库中创建一个用例模块。",
    "sourceFile": "src/modules/v2/pingcode/testhub/library/suite/facade.ts",
