            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "identifier": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "is_archived": {
              "type": "number",
              "x-inferred-from-example": true
            },
            "is_deleted": {
              "type": "number",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "name": {
          "type": "string",
          "description": "用例模块的名称。"
        },
        "parent": {
          "type": "object",
          "description": "父测试模块的引用结构数据。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "paths": {
          "type": "string",
          "description": "用例模块的路径，以`/`分隔。"
        }
      },
      "required": [
        "id",
        "url",
        "library",
        "name",
        "paths"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "55714870a70ea4eb623f6700",
