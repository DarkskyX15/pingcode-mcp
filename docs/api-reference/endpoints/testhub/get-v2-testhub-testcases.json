{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-testhub-testcases",
  "meta": {
    "name": "获取用例列表",
    "method": "GET",
    "path": "/v2/testhub/testcases",
    "group": "用例",
    "groupPath": [
      "测试管理",
      "用例"
    ],
    "area": "测试管理",
    "tags": [
      "用例"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:read:testhub:testcase"
      ]
    },
    "description": "用于简单查询用例列表。  \n 复杂组合、日期或自定义属性过滤请使用「搜索用例列表」。",
    "summary": "用于简单查询用例列表。",
    "sourceFile": "src/modules/v2/pingcode/testhub/case/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E7%94%A8%E4%BE%8B%E5%88%97%E8%A1%A8"
  },
  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string",
            "description": "测试库的 id。"
          },
          "maintenance_id": {
            "type": "string",
            "description": "维护人的 id。"
          },
          "state_id": {
            "type": "string",
            "description": "状态的 id。"
          },
          "important_level_id": {
            "type": "string",
            "description": "重要程度的 id。"
          },
          "tag_id": {
            "type": "string",
            "description": "标签的 id。"
          },
          "keywords": {
            "type": "string",
            "description": "关键字。支持用例编号和用例标题。"
          },
          "created_between": {
            "type": "string",
            "description": "创建时间介于的时间范围，通过','分割起始时间。"
          },
          "updated_between": {
            "type": "string",
            "description": "更新时间介于的时间范围，通过','分割起始时间。"
          },
          "include_public_image_token": {
            "type": "string",
            "description": "包含获取图片资源 token 的属性。使用','分割，最多 32 个。"
          },
          "include_deleted": {
            "type": "boolean",
            "description": "是否查询已删除的用例。该值默认为`false`。"
          }
        }
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "number",
          "description": "每页条数。"
        },
        "page_index": {
          "type": "number",
          "description": "页码，从 0 开始。"
        },
        "total": {
          "type": "number",
          "description": "总条数。"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "用例全量结构数据的数组。"
        }
      },
      "required": [
        "page_size",
        "page_index",
        "total",
        "values"
      ]
    }
  }
}
