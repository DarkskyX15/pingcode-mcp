  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "space_id": {
            "type": "string",
            "description": "空间的 id。"
          },
          "name": {
            "type": "string",
            "description": "页面的名称。"
          },
          "parent_id": {
            "type": "string",
            "description": "父页面的 id。"
          },
          "content": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ],
              "x-pingcode-type": "String/Object"
            },
            "description": "页面的内容。`format_type` 为 `text`/`markdown`/`html` 时为字符串；为 `block` 时为块文档数组（与「获取一个文档正文」返回的 `block` 结构一致）。"
          },
          "format_type": {
            "type": "string",
            "description": "页面内容的格式。content 和 format_type 字段必须同时传递。",
            "enum": [
              "text",
              "markdown",
              "html",
              "block"
            ]
          }
        },
        "required": [
          "space_id",
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "space_id": "63e1bf51760505c8795ebcc8",
            "name": "示例页面",
            "parent_id": "63e1bf51760505c8795ebcce",
            "content": "空间是记录信息和知识的页面集合，通过组织页面层级将知识系统化、结构化，便于团队沉淀经验、共享资源，实现知识增值，加快知识流动，在知识管理层面助力企业更快更好的发布产品。 PingCode 空间支持以下特性： 页面支持插入多种元素以及关联页面，满足编写需要 编辑过程自动保存草稿，无需担心内容丢失 提供丰富的模板，使用模板保持页面的一致性，让空间更加规范 使用锁定功能锁定页面最终版本 删除的页面放进回收站，随时恢复 树状页面结构，直接拖动页面编排目录，让知识管理更方便高效 通过设置成员角色来进行权限控制 通过页面评论实现成员沟通交流，形成反馈闭环  【PingCode 空间】当前处于不断迭代过程中，更多功能即将呈现，敬请期待~",
            "format_type": "text"
          }
        }
      ]
    }
  },
