              },
              "html_url": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "status": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "description": {
                "type": "string",
                "x-inferred-from-example": true
              },
              "submitted_at": {
                "type": "number",
