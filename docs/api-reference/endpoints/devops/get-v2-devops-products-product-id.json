{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-devops-products-product-id",
  "meta": {
    "name": "获取一个托管平台",
    "method": "GET",
    "path": "/v2/devops/products/{product_id}",
    "group": "托管平台",
    "groupPath": [
      "DevOps_数据集成",
      "代码",
      "托管平台"
    ],
    "area": "DevOps_数据集成",
    "tags": [
      "托管平台"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:read:devops:code"
      ]
    },
    "description": "用于按 id 获取托管平台全量信息。",
    "summary": "用于按 id 获取托管平台全量信息。",
    "sourceFile": "src/modules/v2/pingcode/devops/scm/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA%E6%89%98%E7%AE%A1%E5%B9%B3%E5%8F%B0"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "product_id": {
