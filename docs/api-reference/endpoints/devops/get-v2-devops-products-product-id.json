        },
        "name": {
          "type": "string",
          "description": "托管平台的名称。"
        },
        "type": {
          "type": "string",
          "description": "托管平台的类型。",
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "coding.net",
            "gogs",
            "git",
            "svn",
            "gerrit",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "description": "托管平台的描述。"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "description"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "564587fe700d43b81b080765",
          "url": "https://{rest_api_root}/v2/devops/products/564587fe700d43b81b080765",
          "name": "Github",
          "type": "github",
          "description": "Github 公有云"
        }
      }
    ]
