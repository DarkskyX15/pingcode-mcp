{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-devops-prs",
  "meta": {
    "name": "创建一个拉取请求",
    "method": "POST",
    "path": "/v2/devops/prs",
    "group": "拉取请求",
    "groupPath": [
      "DevOps_数据集成",
      "代码",
      "拉取请求"
    ],
    "area": "DevOps_数据集成",
    "tags": [
      "拉取请求"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:write:devops:code"
      ]
    },
    "description": "用于创建一个拉取请求。  \n 代码仓库内实际的拉取请求，用于在 PingCode 中显示拉取请求的详细信息。",
    "summary": "用于创建一个拉取请求。",
    "sourceFile": "src/modules/v2/pingcode/devops/scm/pullrequest.facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E6%8B%89%E5%8F%96%E8%AF%B7%E6%B1%82"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "代码托管平台的 id。"
          },
          "repo_id": {
            "type": "string",
            "description": "代码仓库的 id。"
          },
          "title": {
            "type": "string",
            "description": "拉取请求的标题。"
          },
          "number": {
            "type": "number",
            "description": "拉取请求的编号。同一代码仓库下，该值是唯一的。"
          },
          "creator_name": {
            "type": "string",
            "description": "拉取请求创建者的用户名。"
          },
          "source_branch_id": {
            "type": "string",
            "description": "源分支的 id。"
          },
          "target_branch_id": {
            "type": "string",
            "description": "目标分支的 id。"
          },
          "status": {
            "type": "string",
            "description": "拉取请求的状态。",
            "enum": [
              "open",
              "closed",
              "merged",
              "abandoned"
            ]
          },
          "description": {
            "type": "string",
            "description": "拉取请求的描述。"
          },
          "merged_at": {
            "type": "number",
            "description": "拉取请求合并的时间。当拉取请求状态为 `merged` 时，该值为必填。"
          },
          "merged_commit_sha": {
            "type": "string",
            "description": "源分支最后一次提交的 SHA 值。当拉取请求状态为 `merged` 时，该值为必填。"
          },
          "merged_by_name": {
            "type": "string",
            "description": "拉取请求合并者的用户名。当拉取请求状态为 `merged` 时，该值为必填。"
          },
          "comments_count": {
            "type": "number",
            "description": "拉取请求的评论数量。"
          },
          "review_comments_count": {
            "type": "number",
            "description": "代码评审的评论数量。"
          },
          "commits_count": {
            "type": "number",
            "description": "代码的提交数量。"
          },
          "additions_count": {
            "type": "number",
            "description": "新增文件的数量。"
          },
          "deletions_count": {
            "type": "number",
            "description": "删除文件的数量。"
          },
          "changed_files_count": {
            "type": "number",
            "description": "更改文件的数量。"
          },
          "workitem_identifiers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "PingCode 工作项编号的列表。通过该参数将拉取请求与一个或多个工作项关联。",
            "x-inferred-from-example": true
          }
        },
        "required": [
          "product_id",
          "repo_id",
          "title",
          "number",
          "creator_name",
          "target_branch_id",
          "status"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "product_id": "564587fe700d43b81b080765",
            "repo_id": "564587fe700d43b81b080766",
            "title": "fix(doc): #PLM-001 fix document title",
            "number": 1,
            "creator_name": "terry",
            "description": "Please give some great suggestions",
            "source_branch_id": "564587fe700d43b81b080767",
            "target_branch_id": "564587fe700d43b81b080776",
            "status": "merged",
            "merged_at": 1473018919,
            "merged_commit_sha": "96a024347146ebdc5f481f45e6e6871e0c43af5f",
            "merged_by_name": "terry",
            "workitem_identifiers": [
              "PLM-001"
            ]
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object"
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "raw": "同「获取一个拉取请求」响应结构。"
      }
    ]
  }
}
