{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-devops-repos-repo-id",
  "meta": {
    "name": "获取一个代码仓库",
    "method": "GET",
    "path": "/v2/devops/repos/{repo_id}",
    "group": "代码仓库",
    "groupPath": [
      "DevOps_数据集成",
      "代码",
      "代码仓库"
    ],
    "area": "DevOps_数据集成",
    "tags": [
      "代码仓库"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:read:devops:code"
      ]
    },
    "description": "用于按 id 获取代码仓库全量信息。",
    "summary": "用于按 id 获取代码仓库全量信息。",
    "sourceFile": "src/modules/v2/pingcode/devops/scm/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA%E4%BB%A3%E7%A0%81%E4%BB%93%E5%BA%93"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "repo_id": {
            "type": "string",
            "description": "代码仓库的 id。"
          }
        },
        "required": [
          "repo_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "代码仓库的 id。"
        },
        "url": {
          "type": "string",
          "description": "代码仓库的资源地址。"
        },
        "html_url": {
          "type": "string",
          "description": "代码仓库的地址。"
        },
        "product": {
          "type": "object",
          "description": "托管平台。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "type": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "name": {
          "type": "string",
          "description": "代码仓库的名称。"
        },
        "full_name": {
          "type": "string",
          "description": "代码仓库的全称。"
        },
        "created_at": {
          "type": "number",
          "description": "代码仓库的创建时间。"
        },
        "owner": {
          "type": "object",
          "description": "代码仓库的拥有者。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "is_fork": {
          "type": "boolean",
          "description": "代码仓库是否是 fork 仓库。"
        },
        "is_private": {
          "type": "boolean",
          "description": "代码仓库是否是私有仓库。"
        },
        "description": {
          "type": "string",
          "description": "代码仓库的描述。"
        },
        "branches_url": {
          "type": "string",
          "description": "代码仓库的分支地址模板，链接后面括号里的值会被替换成真实地址。"
        },
        "commits_url": {
          "type": "string",
          "description": "代码仓库的提交地址模板，链接后面括号里的值会被替换成真实地址"
        },
        "compare_url": {
          "type": "string",
          "description": "代码仓库的分支对比地址模板，链接后面括号里的值会被替换成真实地址"
        },
        "pulls_url": {
          "type": "string",
          "description": "代码仓库的拉取请求地址模板，链接后面括号里的值会被替换成真实地址"
        }
      },
      "required": [
        "id",
        "url",
        "html_url",
        "product",
        "name",
        "full_name",
        "created_at",
        "owner",
        "is_fork",
        "is_private",
        "description",
        "branches_url",
        "commits_url",
        "compare_url",
        "pulls_url"
      ]
    },
    "examples": [
