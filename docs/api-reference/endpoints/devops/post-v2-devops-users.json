{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-devops-users",
  "meta": {
    "name": "创建一个托管平台用户",
    "method": "POST",
    "path": "/v2/devops/users",
    "group": "托管平台用户",
    "groupPath": [
      "DevOps_数据集成",
      "代码",
      "托管平台用户"
    ],
    "area": "DevOps_数据集成",
    "tags": [
      "托管平台用户"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:write:devops:code"
      ]
    },
    "description": "用于创建一个托管平台用户。  \n 代码托管平台内实际的用户，用于在 PingCode 中显示该用户在代码托管平台上的名称、头像以及主页的信息。如果没有手动创建用户，在操作代码仓库、分支、拉取请求时，将自动创建仅包含该用户名的用户。",
    "summary": "用于创建一个托管平台用户。",
    "sourceFile": "src/modules/v2/pingcode/devops/scm/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E6%89%98%E7%AE%A1%E5%B9%B3%E5%8F%B0%E7%94%A8%E6%88%B7"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "代码托管平台的 id。"
          },
          "name": {
            "type": "string",
            "description": "代码托管平台上的用户名，同一代码托管平台下，该用户名是唯一的。"
          },
          "display_name": {
            "type": "string",
            "description": "用户显示名。"
          },
          "html_url": {
            "type": "string",
            "description": "代码托管平台上的用户主页地址。"
          },
          "avatar_url": {
            "type": "string",
            "description": "代码托管平台上的用户头像地址。"
          }
        },
        "required": [
          "product_id",
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "product_id": "564587fe700d43b81b080765",
            "name": "terry",
            "display_name": "Terry",
            "html_url": "https://github.com/terrylee",
            "avatar_url": "https://avatars2.githubusercontent.com/u/694592?v=4"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "托管平台用户的 id。"
        },
        "url": {
          "type": "string",
          "description": "托管平台用户的资源地址。"
        },
        "html_url": {
          "type": "string",
          "description": "代码托管平台上的用户主页地址。"
        },
        "product": {
          "type": "object",
          "description": "托管平台的引用结构数据。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "type": {
              "type": "string",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        },
        "name": {
          "type": "string",
          "description": "托管平台用户的名称。"
        },
        "display_name": {
          "type": "string",
          "description": "托管平台用户的显示名。"
        },
        "avatar_url": {
          "type": "string",
          "description": "代码托管平台上的用户头像地址。"
        }
      },
      "required": [
        "id",
        "url",
        "html_url",
        "product",
        "name",
        "display_name",
        "avatar_url"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "5666aea91f99e33cb7c44964",
          "url": "https://{rest_api_root}/v2/devops/users/5666aea91f99e33cb7c44964",
          "html_url": "https://github.com/terrylee",
          "product": {
            "id": "564587fe700d43b81b080765",
            "url": "https://{rest_api_root}/v2/devops/products/564587fe700d43b81b080765",
            "name": "Github",
            "type": "github"
          },
          "name": "terry",
          "display_name": "Terry",
          "avatar_url": "https://avatars2.githubusercontent.com/u/694592?v=4"
        }
      }
    ]
  }
}
