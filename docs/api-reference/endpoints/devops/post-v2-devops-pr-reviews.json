{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-devops-pr-reviews",
  "meta": {
    "name": "创建一个代码评审",
    "method": "POST",
    "path": "/v2/devops/pr_reviews",
    "group": "代码评审",
    "groupPath": [
      "DevOps_数据集成",
      "代码",
      "代码评审"
    ],
    "area": "DevOps_数据集成",
    "tags": [
      "代码评审"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:write:devops:code"
      ]
    },
    "description": "用于创建一个代码评审。  \n 拉取请求实际的代码评审记录，用于在 PingCode 中显示代码评审的详细信息。",
    "summary": "用于创建一个代码评审。",
    "sourceFile": "src/modules/v2/pingcode/devops/scm/pullrequest.facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E4%BB%A3%E7%A0%81%E8%AF%84%E5%AE%A1"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "代码托管平台的 id。"
          },
          "repo_id": {
            "type": "string",
            "description": "代码仓库的 id。"
          },
          "pr_id": {
            "type": "string",
            "description": "拉取请求的 id。"
          },
          "status": {
            "type": "string",
            "description": "代码评审的状态。",
            "enum": [
              "comment",
              "approved",
              "request_changes"
            ]
          },
          "reviewer_name": {
            "type": "string",
            "description": "评审人的用户名。"
          },
          "description": {
            "type": "string",
            "description": "代码评审的描述。"
          },
          "submitted_at": {
            "type": "number",
            "description": "提交的时间。"
          },
          "html_url": {
            "type": "string",
            "description": "代码评审的地址。如果为空，在 PingCode 中不显示相关跳转链接。"
          }
        },
        "required": [
          "product_id",
          "repo_id",
          "pr_id",
          "status",
          "reviewer_name",
          "submitted_at"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "product_id": "564587fe700d43b81b080765",
            "repo_id": "564587fe700d43b81b080766",
            "pr_id": "594587fe700d43b81b080789",
            "status": "approved",
            "reviewer_name": "anytao",
            "description": "Review has approved",
            "submitted_at": 1403014111,
            "html_url": "https://github.com/worktile/ngx-planet/pull/127#pullrequestreview-384383294"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object"
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "raw": "同「获取一个代码评审」响应结构。"
      }
    ]
  }
}
