{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-ship-tags",
  "meta": {
    "name": "创建一个产品标签",
    "method": "POST",
    "path": "/v2/ship/tags",
    "group": "产品配置",
    "groupPath": [
      "产品管理",
      "产品配置中心",
      "产品配置"
    ],
    "area": "产品管理",
    "tags": [
      "产品配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:ship:product"
      ]
    },
    "description": "用于创建一个标签。",
    "summary": "用于创建一个标签。",
    "sourceFile": "src/modules/v2/pingcode/ship/configuration/product/tag/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E4%BA%A7%E5%93%81%E6%A0%87%E7%AD%BE"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "产品的 id。传入时创建该产品的本地标签；不传则创建全局标签。"
          },
          "name": {
            "type": "string",
            "description": "标签的名称。在同一范围内（全局或同一产品）名称唯一。"
          }
        },
        "required": [
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "name": "标签-1"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "标签的 id。"
        },
        "url": {
          "type": "string",
          "description": "标签的资源地址。"
        },
        "name": {
          "type": "string",
          "description": "标签的名称。"
        },
        "color": {
          "type": "string",
          "description": "标签的颜色。"
        },
        "product": {
          "type": "object",
          "description": "产品的引用结构数据。该标签是此产品的本地标签。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "identifier": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "is_archived": {
              "type": "number",
              "x-inferred-from-example": true
            },
            "is_deleted": {
              "type": "number",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "color",
        "product"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "63eca881a0a13a3efc8d49f0",
          "url": "https://{rest_api_root}/v2/ship/tags/63eca881a0a13a3efc8d49f0",
          "name": "标签-1",
          "color": "#56ABFB",
          "product": {
            "id": "6422711c3f12e6c1e46d40e6",
            "url": "https://{rest_api_root}/v2/ship/products/6422711c3f12e6c1e46d40e6",
            "identifier": "SLC",
            "name": "示例产品",
            "is_archived": 0,
            "is_deleted": 0
          }
        }
      }
    ]
  }
}
