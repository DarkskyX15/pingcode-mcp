{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-ship-idea-states",
  "meta": {
    "name": "创建一个需求状态",
    "method": "POST",
    "path": "/v2/ship/idea_states",
    "group": "需求配置",
    "groupPath": [
      "产品管理",
      "产品配置中心",
      "需求配置"
    ],
    "area": "产品管理",
    "tags": [
      "需求配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:ship:configuration"
      ]
    },
    "description": "用于创建一个需求状态。",
    "summary": "用于创建一个需求状态。",
    "sourceFile": "src/modules/v2/pingcode/ship/configuration/idea/state/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E9%9C%80%E6%B1%82%E7%8A%B6%E6%80%81"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "需求状态的名称，在一个企业中这个名称是唯一的。"
          },
          "type": {
            "type": "string",
            "description": "需求状态的类型。",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "closed"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "name": "待评审",
            "type": "pending"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "需求状态的 id。"
        },
        "url": {
          "type": "string",
          "description": "需求状态的资源地址。"
        },
        "name": {
          "type": "string",
          "description": "需求状态的名称。"
        },
        "type": {
          "type": "string",
          "description": "需求状态的类型。",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "closed"
          ]
        },
        "color": {
          "type": "string",
          "description": "需求状态的颜色。"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "color"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "63e1bf51898a0be5a2d21b2a",
          "url": "https://{rest_api_root}/v2/ship/idea_states/63e1bf51898a0be5a2d21b2a",
          "name": "待评审",
          "type": "pending",
          "color": "#56ABFB"
        }
      }
    ]
  }
}
