{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "get-v2-ship-idea-states-idea-state-id",
  "meta": {
    "name": "获取一个需求状态",
    "method": "GET",
    "path": "/v2/ship/idea_states/{idea_state_id}",
    "group": "需求配置",
    "groupPath": [
      "产品管理",
      "产品配置中心",
      "需求配置"
    ],
    "area": "产品管理",
    "tags": [
      "需求配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:read:ship:configuration"
      ]
    },
    "description": "用于按 id 获取需求状态全量信息。",
    "summary": "用于按 id 获取需求状态全量信息。",
    "sourceFile": "src/modules/v2/pingcode/ship/configuration/idea/state/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA%E9%9C%80%E6%B1%82%E7%8A%B6%E6%80%81"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "idea_state_id": {
            "type": "string",
            "description": "需求状态的 id。"
          }
        },
        "required": [
          "idea_state_id"
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "需求状态的 id。"
        },
        "url": {
          "type": "string",
          "description": "需求状态的资源地址。"
        },
        "name": {
          "type": "string",
          "description": "需求状态的名称。"
        },
        "type": {
          "type": "string",
          "description": "需求状态的类型。",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "closed"
          ]
        },
        "color": {
          "type": "string",
          "description": "需求状态的颜色。"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "color"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "63e1bf51898a0be5a2d21b2a",
