{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-nexus-webhook-get-url",
  "meta": {
    "name": "获取一个_Webhook_URL",
    "method": "POST",
    "path": "/v2/nexus/webhook/get_url",
    "group": "Webhook",
    "groupPath": [
      "事件",
      "Webhook"
    ],
    "area": "事件",
    "tags": [
      "Webhook"
    ],
    "listed": false,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:event:app"
      ]
    },
    "description": "为指定 `web_trigger_key` 获取一个对外可访问的 Webhook URL；若不存在则创建。参考 [webhook.getUrl](https://open.pingcode.com/reference/functions/events/webhook-url#geturl)。",
    "summary": "为指定 web_trigger_key 获取一个对外可访问的 Webhook URL；若不存在则创建。参考 webhook.getUrl。",
    "sourceFile": "src/modules/v2/nexus/event/webhook/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA_Webhook_URL"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "web_trigger_key": {
            "type": "string",
            "description": "manifest 文件中配置的 web trigger key。"
          },
          "options": {
            "type": "object",
            "description": "可选配置项。",
            "properties": {
              "force_create": {
                "type": "boolean",
                "description": "是否强制重新生成新 URL。为 `true` 始终创建新的 Webhook URL; `false` 返回已经存在的 Webhook URL 或者创建新的 Webhook URL。默认值为 `false`。"
              }
            }
          }
        },
        "required": [
          "web_trigger_key"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "web_trigger_key": "incoming-build",
            "options": {
              "force_create": false
            }
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "x-inferred-from-example": true
        }
      },
      "x-inferred-from-example": true
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "url": "https://{nexus_webhook_root}/wh/{uuid}"
        }
      }
    ]
  }
}
