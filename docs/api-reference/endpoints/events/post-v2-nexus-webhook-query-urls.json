{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-nexus-webhook-query-urls",
  "meta": {
    "name": "获取_Webhook_URL_列表",
    "method": "POST",
    "path": "/v2/nexus/webhook/query_urls",
    "group": "Webhook",
    "groupPath": [
      "事件",
      "Webhook"
    ],
    "area": "事件",
    "tags": [
      "Webhook"
    ],
    "listed": false,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌"
      ],
      "scopes": [
        "pcp:event:app"
      ]
    },
    "description": "获取当前安装下已分配的 Webhook URL 列表，可通过 `web_trigger_key` 过滤。参考 [webhook.queryUrls](https://open.pingcode.com/reference/functions/events/webhook-url#queryurls)。",
    "summary": "获取当前安装下已分配的 Webhook URL 列表，可通过 web_trigger_key 过滤。参考 webhook.queryUrls。",
    "sourceFile": "src/modules/v2/nexus/event/webhook/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96_Webhook_URL_%E5%88%97%E8%A1%A8"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "web_trigger_key": {
            "type": "string",
            "description": "通过 web trigger key 过滤；不传则返回当前安装下所有 Webhook URL。"
          }
        }
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "web_trigger_key": "incoming-build"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object"
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": [
          {
            "web_trigger_key": "incoming-build",
            "url": "https://{nexus_webhook_root}/wh/{uuid}"
          }
        ]
      }
    ]
  }
}
