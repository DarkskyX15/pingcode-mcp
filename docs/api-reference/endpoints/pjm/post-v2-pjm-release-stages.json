{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-pjm-release-stages",
  "meta": {
    "name": "创建一个发布阶段",
    "method": "POST",
    "path": "/v2/pjm/release_stages",
    "group": "项目配置",
    "groupPath": [
      "项目管理",
      "项目配置中心",
      "项目配置"
    ],
    "area": "项目管理",
    "tags": [
      "项目配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:pjm:configuration"
      ]
    },
    "description": "用于创建一个发布阶段。",
    "summary": "用于创建一个发布阶段。",
    "sourceFile": "src/modules/v2/pingcode/pjm/configuration/project-config/stage/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E5%8F%91%E5%B8%83%E9%98%B6%E6%AE%B5"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "发布阶段的名称。在一个企业中这个名称是唯一的。"
          },
          "type": {
            "type": "string",
            "description": "发布阶段的类型。",
            "enum": [
              "pending",
              "in_progress",
              "published"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "name": "新建",
            "type": "pending"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "发布阶段的 id。"
        },
        "url": {
          "type": "string",
          "description": "发布阶段的地址。"
        },
        "name": {
          "type": "string",
          "description": "发布阶段的名称。"
        },
        "type": {
          "type": "string",
          "description": "发布阶段的类型。",
          "enum": [
            "pending",
            "in_progress",
            "published"
          ]
        },
        "color": {
          "type": "string",
          "description": "发布阶段的颜色。"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "color"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "5c9b35de90ad7153c2062f18",
          "url": "https://{rest_api_root}/v2/pjm/release_stages/5c9b35de90ad7153c2062f18",
          "name": "新建",
          "type": "pending",
          "color": "#ff7575"
        }
      }
    ]
  }
}
