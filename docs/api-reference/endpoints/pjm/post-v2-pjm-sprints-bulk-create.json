                "description": "迭代负责人的 id。"
              },
              "description": {
                "type": "string",
                "description": "迭代的描述。"
              },
              "status": {
                "type": "string",
                "description": "迭代的状态。",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              },
              "category_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "迭代类别的 id 列表。"
              },
