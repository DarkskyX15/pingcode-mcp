  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "项目的 id。"
          }
        },
        "required": [
          "project_id"
        ]
      }
    },
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "scope_type": {
            "type": "string",
            "description": "项目的所属类型。默认使用原项目的所属。允许值分别表示企业可见和团队可见。",
            "enum": [
              "organization",
              "user_group"
            ]
          },
          "scope_id": {
            "type": "string",
            "description": "项目的所属 id。当 `scope_type` 为 `user_group` 时，该字段必填，且表示团队 id；当 `scope_type` 为其他值时，该字段无效。"
          },
          "name": {
            "type": "string",
            "description": "项目的名称。最大长度为 255。默认使用原项目的名称。"
          },
          "visibility": {
            "type": "string",
            "description": "项目的可见范围。默认使用原项目的可见范围。允许值分别表示组织全部成员可见和仅项目成员可见。",
            "enum": [
              "public",
              "private"
            ]
          },
          "identifier": {
            "type": "string",
            "description": "项目的标识。在一个企业中这个标识是唯一的。项目的标识由大写英文字母/数字/下划线/连接线组成（不超过 15 个字符）。"
          },
          "description": {
            "type": "string",
            "description": "项目的描述。默认使用原项目的描述。"
          },
          "members": {
            "type": "object",
            "items": {
              "type": "object"
            },
            "description": "项目成员的列表。当项目的 `scope_type` 变为 `user_group` 时，项目成员必须是 `scope_id` 指定的团队内的成员；当 `scope_type` 为其他值时，项目成员可以是任意成员或团队，默认使用原项目的成员列表。",
            "properties": {
              "id": {
                "type": "string",
                "description": "企业成员或团队的 id。"
              },
              "type": {
                "type": "string",
                "description": "项目成员的类型。",
                "enum": [
                  "user",
                  "user_group"
                ]
              }
            },
            "required": [
              "id",
              "type"
            ]
          }
        },
        "required": [
          "identifier"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "scope_type": "user_group",
            "scope_id": "63c8fb32729dee3334d96af7",
            "name": "复制的 Scrum 项目",
            "visibility": "public",
            "identifier": "SCRC",
            "description": "这是一个复制的 Scrum 类型的项目",
            "members": [
              {
                "id": "a0417f68e846aae315c85d24643678a9",
                "type": "user"
              }
            ]
          }
        }
      ]
    }
  },
