        },
        "name": {
          "type": "string",
          "description": "工作项状态的名称。"
        },
        "type": {
          "type": "string",
          "description": "工作项状态的类型。",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "closed"
          ]
        },
        "color": {
          "type": "string",
          "description": "工作项状态的颜色。"
