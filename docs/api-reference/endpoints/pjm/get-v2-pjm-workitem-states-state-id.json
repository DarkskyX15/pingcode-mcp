        "is_system": {
          "type": "number",
          "description": "是否为系统内置状态。",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "color",
        "is_system"
      ]
    },
