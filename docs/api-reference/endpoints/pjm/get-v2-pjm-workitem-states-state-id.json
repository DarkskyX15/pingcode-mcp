      ],
      "scopes": [
        "pcp:read:pjm:configuration"
      ]
    },
    "description": "用于按 id 获取工作项状态全量信息。",
    "summary": "用于按 id 获取工作项状态全量信息。",
    "sourceFile": "src/modules/v2/pingcode/pjm/configuration/work-item-config/state/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E8%8E%B7%E5%8F%96%E4%B8%80%E4%B8%AA%E5%B7%A5%E4%BD%9C%E9%A1%B9%E7%8A%B6%E6%80%81"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "state_id": {
            "type": "string",
            "description": "工作项状态的 id。"
          }
        },
        "required": [
