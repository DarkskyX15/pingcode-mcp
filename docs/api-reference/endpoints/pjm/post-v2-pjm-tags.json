{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-pjm-tags",
  "meta": {
    "name": "创建一个项目标签",
    "method": "POST",
    "path": "/v2/pjm/tags",
    "group": "项目配置",
    "groupPath": [
      "项目管理",
      "项目配置中心",
      "项目配置"
    ],
    "area": "项目管理",
    "tags": [
      "项目配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:pjm:configuration"
      ]
    },
    "description": "用于创建一个项目标签。传入 `project_id` 时创建指定项目下的标签；不传时创建企业级标签。",
    "summary": "用于创建一个项目标签。传入 project_id 时创建指定项目下的标签；不传时创建企业级标签。",
    "sourceFile": "src/modules/v2/pingcode/pjm/configuration/project-config/tag/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E9%A1%B9%E7%9B%AE%E6%A0%87%E7%AD%BE"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "标签的名称。在同一作用域内这个名称是唯一的。"
          },
          "project_id": {
            "type": "string",
            "description": "项目的 id。"
          }
        },
        "required": [
          "name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "name": "标签-1",
            "project_id": "5eb623f6a70571487ea41919"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "项目标签的 id。"
        },
        "url": {
          "type": "string",
          "description": "项目标签的地址。"
        },
        "name": {
          "type": "string",
          "description": "项目标签的名称。"
        },
        "color": {
          "type": "string",
          "description": "项目标签的颜色。"
        },
        "project": {
          "type": "object",
          "description": "项目的引用结构数据。该标签是此项目的本地标签。",
          "properties": {
            "id": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "url": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "identifier": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "name": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "template_type": {
              "type": "string",
              "x-inferred-from-example": true
            },
            "is_archived": {
              "type": "number",
              "x-inferred-from-example": true
            },
            "is_deleted": {
              "type": "number",
              "x-inferred-from-example": true
            }
          },
          "x-inferred-from-example": true
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "color",
        "project"
      ]
    },
    "examples": [
      {
