{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "patch-v2-pjm-workitem-states-state-id",
  "meta": {
    "name": "部分更新一个工作项状态",
    "method": "PATCH",
    "path": "/v2/pjm/workitem_states/{state_id}",
    "group": "工作项配置",
    "groupPath": [
      "项目管理",
      "项目配置中心",
      "工作项配置"
    ],
    "area": "项目管理",
    "tags": [
      "工作项配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:pjm:configuration"
      ]
    },
    "description": "用于部分更新一个工作项状态。  \n 仅非系统内置状态可更新。",
    "summary": "用于部分更新一个工作项状态。",
    "sourceFile": "src/modules/v2/pingcode/pjm/configuration/work-item-config/state/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E9%83%A8%E5%88%86%E6%9B%B4%E6%96%B0%E4%B8%80%E4%B8%AA%E5%B7%A5%E4%BD%9C%E9%A1%B9%E7%8A%B6%E6%80%81"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "state_id": {
            "type": "string",
            "description": "工作项状态的 id。"
          }
        },
        "required": [
          "state_id"
        ]
      }
    },
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "工作项状态的名称。在一个企业中这个名称是唯一的。"
          },
          "type": {
            "type": "string",
            "description": "工作项状态的类型。",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "closed"
            ]
          }
        }
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "name": "新建",
            "type": "pending"
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "工作项状态的 id。"
        },
        "url": {
          "type": "string",
          "description": "工作项状态的地址。"
        },
        "name": {
          "type": "string",
          "description": "工作项状态的名称。"
        },
        "type": {
          "type": "string",
          "description": "工作项状态的类型。",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "closed"
          ]
        },
        "color": {
          "type": "string",
          "description": "工作项状态的颜色。"
        },
        "is_system": {
          "type": "number",
          "description": "是否为系统内置状态。",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "color",
        "is_system"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "5c9b35de90ad7153c2062f18",
          "url": "https://{rest_api_root}/v2/pjm/workitem_states/5c9b35de90ad7153c2062f18",
          "name": "新建",
          "type": "pending",
          "color": "#ff7575",
          "is_system": 0
        }
      }
    ]
  }
}
