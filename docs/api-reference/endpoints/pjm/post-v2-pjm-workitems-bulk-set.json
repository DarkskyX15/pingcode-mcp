          },
          "property_value": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "object"
                }
              ],
              "x-pingcode-type": "String/Number/String[]/Object"
            },
            "description": "要写入的属性值，取值规则与「部分更新一个工作项」中同名参数一致。"
          }
        },
        "required": [
          "ids",
          "property_name"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "ids": [
              "547000eb6a70571487623fea"
            ],
            "property_name": "title",
            "property_value": "这是一个工作项"
          }
        }
      ]
    }
