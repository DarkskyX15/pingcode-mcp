{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "post-v2-pjm-project-properties",
  "meta": {
    "name": "创建一个项目属性",
    "method": "POST",
    "path": "/v2/pjm/project_properties",
    "group": "项目配置",
    "groupPath": [
      "项目管理",
      "项目配置中心",
      "项目配置"
    ],
    "area": "项目管理",
    "tags": [
      "项目配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:pjm:configuration"
      ]
    },
    "description": "用于创建一个项目属性。",
    "summary": "用于创建一个项目属性。",
    "sourceFile": "src/modules/v2/pingcode/pjm/configuration/project-config/project-property/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E9%A1%B9%E7%9B%AE%E5%B1%9E%E6%80%A7"
  },
  "request": {
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "项目属性的名称。在一个企业中这个名称是唯一的。"
          },
          "type": {
            "type": "string",
            "description": "项目属性的类型。",
            "enum": [
              "text",
              "textarea",
              "select",
              "multi_select",
              "cascade_select",
              "cascade_multi_select",
              "member",
              "members",
              "date",
              "number",
              "progress",
              "rate",
              "link",
              "referred_select",
              "referred_multi_select"
            ]
          },
          "referred_object_type": {
            "type": "string",
            "description": "引用对象的类型，当属性类型为 referred_select,referred_multi_select 时必填。用于限定该属性值是哪种数据类型的 id 或 id 数组。",
            "enum": [
              "product",
              "project",
              "library",
              "space"
            ]
          },
          "options": {
            "type": "object",
            "items": {
              "type": "object"
            },
            "description": "选择项列表。当属性类型为 `select,multi_select,cascade_select,cascade_multi_select` 时可选填此项。",
            "properties": {
              "id": {
                "type": "string",
                "description": "选择项 id。该值在选择项中是唯一的。"
              },
              "text": {
                "type": "string",
                "description": "选择项内容。该值在选择项中是唯一的。"
              },
              "parent_id": {
                "type": "string",
                "description": "选择项父级 id。当属性类型为 `cascade_select,cascade_multi_select` 时，`parent_id` 参数有效，用于构建级联类型选择项之间的父子关系，最多存在 4 级。"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "examples": [
        {
          "name": "请求示例：",
          "type": "json",
          "value": {
            "name": "项目风险",
            "type": "select",
            "options": [
              {
                "text": "高"
              },
              {
                "id": "5efb1859110533727a82c604",
                "text": "中"
              },
              {
                "id": "5efb1859110533727a82c605",
                "text": "低"
              }
            ]
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "项目属性的 id。"
        },
        "url": {
          "type": "string",
          "description": "项目属性的地址。"
        },
        "name": {
          "type": "string",
          "description": "项目属性的名称。"
        },
        "type": {
          "type": "string",
          "description": "项目属性的类型。"
        },
        "referred_object_type": {
          "type": "string",
          "description": "引用对象类型。"
        },
        "options": {
          "type": "object",
          "items": {
            "type": "object"
          },
          "description": "下拉选项值。",
          "properties": {
            "id": {
              "type": "string",
              "description": "选择项 id。该值在选择项中是唯一的。"
            },
            "text": {
              "type": "string",
              "description": "选择项内容。该值在选择项中是唯一的。"
            },
            "color": {
              "type": "string",
              "description": "选择项颜色。"
            },
            "parent_id": {
              "type": "string",
              "description": "选择项父级 id。当属性类型为 `cascade_select` 或 `cascade_multi_select` 时返回，用于表示级联选择项的父子关系。"
            }
          },
          "required": [
            "id",
            "text",
            "color",
            "parent_id"
          ]
        },
        "is_removable": {
          "type": "number",
          "description": "是否允许删除。"
        },
        "is_name_editable": {
          "type": "number",
          "description": "是否允许修改名称。"
        },
        "is_options_editable": {
          "type": "number",
          "description": "是否允许修改下拉选项值。"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "referred_object_type",
        "options",
        "is_removable",
        "is_name_editable",
        "is_options_editable"
      ]
    },
    "examples": [
      {
        "name": "响应示例：",
        "type": "json",
        "value": {
          "id": "risk",
          "url": "https://{rest_api_root}/v2/pjm/project_properties/risk",
          "name": "项目风险",
          "type": "select",
          "options": [
            {
              "id": "5efb1859110533727a82c603",
              "text": "高",
              "color": "#FF7575"
            },
            {
              "id": "5efb1859110533727a82c604",
              "text": "中",
              "color": "#FF7575"
            },
            {
              "id": "5efb1859110533727a82c605",
              "text": "低",
              "color": "#FF7575"
            }
          ],
          "is_removable": 0,
          "is_name_editable": 0,
          "is_options_editable": 0
        }
      }
    ]
  }
}
