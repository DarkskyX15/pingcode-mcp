{
  "schemaVersion": "pingcode-endpoint/1",
  "id": "patch-v2-pjm-workitem-properties-workitem-property-id",
  "meta": {
    "name": "部分更新一个工作项属性",
    "method": "PATCH",
    "path": "/v2/pjm/workitem_properties/{workitem_property_id}",
    "group": "工作项配置",
    "groupPath": [
      "项目管理",
      "项目配置中心",
      "工作项配置"
    ],
    "area": "项目管理",
    "tags": [
      "工作项配置"
    ],
    "listed": true,
    "version": "2.0.0",
    "auth": {
      "tokens": [
        "企业令牌",
        "用户令牌"
      ],
      "scopes": [
        "pcp:write:pjm:configuration"
      ]
    },
    "description": "用于部分更新一个工作项属性。",
    "summary": "用于部分更新一个工作项属性。",
    "sourceFile": "src/modules/v2/pingcode/pjm/configuration/work-item-config/property/facade.ts",
    "docsUrl": "https://open.pingcode.com/#api-%E9%83%A8%E5%88%86%E6%9B%B4%E6%96%B0%E4%B8%80%E4%B8%AA%E5%B7%A5%E4%BD%9C%E9%A1%B9%E5%B1%9E%E6%80%A7"
  },
  "request": {
    "path": {
      "schema": {
        "type": "object",
        "properties": {
          "workitem_property_id": {
            "type": "string",
            "description": "工作项属性的 id。"
          }
        },
        "required": [
          "workitem_property_id"
        ]
      }
    },
    "body": {
      "required": true,
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "工作项属性的名称。在一个企业中这个名称是唯一的。"
          },
          "referred_object_type": {
            "type": "string",
            "description": "引用对象的类型，当属性类型为 referred_select,referred_multi_select 时必填。用于限定该属性值是哪种数据类型的 id 或 id 数组。",
            "enum": [
              "product",
              "project",
              "library",
              "space"
            ]
          },
          "options": {
            "type": "object",
            "items": {
              "type": "object"
            },
            "description": "选择项列表。`options` 是整体更新的。",
            "properties": {
              "id": {
                "type": "string",
                "description": "选择项 id。该值在选择项中是唯一的。"
              },
              "text": {
                "type": "string",
                "description": "选择项内容。该值在选择项中是唯一的。"
              },
              "parent_id": {
                "type": "string",
                "description": "选择项父级 id。当属性类型为 `cascade_select,cascade_multi_select` 时，`parent_id` 参数有效，用于构建级联类型选择项之间的父子关系，最多存在 4 级。"
              }
            },
            "required": [
              "text"
            ]
          }
        }
      },
      "examples": [
        {
          "name": "请求示例（select）：",
          "type": "json",
          "value": {
            "name": "严重程度-update",
            "options": [
              {
                "id": "5efb1859110533727a82c603",
                "text": "严重-update"
              },
              {
                "id": "5efb1859110533727a82c624",
                "text": "一般"
              }
            ]
          }
        },
        {
          "name": "请求示例（cascade_select）：",
          "type": "json",
          "value": {
            "name": "级联单选-update",
            "options": [
              {
                "id": "64b9f741eec7fd94e63b411e",
                "text": "父-update"
              },
              {
                "id": "64b9f741eec7fd94e63b411f",
                "text": "子-update",
                "parent_id": "64b9f741eec7fd94e63b411e"
              },
              {
                "text": "子-create",
                "parent_id": "64b9f741eec7fd94e63b411f"
              }
            ]
          }
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "工作项属性的 id。"
        },
        "url": {
          "type": "string",
          "description": "工作项属性的地址。"
        },
        "name": {
          "type": "string",
          "description": "工作项属性的名称。"
        },
        "type": {
          "type": "string",
          "description": "工作项属性的类型。"
        },
        "referred_object_type": {
          "type": "string",
          "description": "引用对象类型。"
        },
        "options": {
          "type": "object",
          "items": {
            "type": "object"
          },
          "description": "下拉选项值。",
          "properties": {
            "id": {
              "type": "string",
              "description": "选择项 id。该值在选择项中是唯一的。"
            },
            "text": {
              "type": "string",
              "description": "选择项内容。该值在选择项中是唯一的。"
            },
            "color": {
              "type": "string",
              "description": "选择项颜色。"
            },
            "parent_id": {
              "type": "string",
              "description": "选择项父级 id。当属性类型为 `cascade_select` 或 `cascade_multi_select` 时返回，用于表示级联选择项的父子关系。"
            }
          },
          "required": [
            "id",
            "text",
            "color",
            "parent_id"
          ]
        },
        "is_removable": {
          "type": "number",
          "description": "是否允许删除。"
        },
        "is_name_editable": {
          "type": "number",
          "description": "是否允许修改名称。"
        },
        "is_options_editable": {
          "type": "number",
          "description": "是否允许修改下拉选项值。"
        },
        "select_all_level": {
          "type": "boolean",
          "description": "级联选择时是否允许选择全部层级。"
        },
        "display_all_level": {
          "type": "boolean",
          "description": "级联选择时是否展示全部层级。"
        },
        "display_separator": {
          "type": "string",
          "description": "级联选择时的层级分隔符。"
        }
      },
      "required": [
        "id",
        "url",
        "name",
        "type",
        "referred_object_type",
        "options",
        "is_removable",
        "is_name_editable",
        "is_options_editable",
        "select_all_level",
        "display_all_level",
        "display_separator"
      ]
    },
    "examples": [
      {
        "name": "响应示例（select）：",
        "type": "json",
        "value": {
          "id": "severity-update",
          "url": "https://{rest_api_root}/v2/pjm/workitem_properties/severity",
          "name": "严重程度-update",
          "type": "select",
          "options": [
            {
              "id": "5efb1859110533727a82c603",
              "text": "严重-update",
              "color": "#FF7575"
            },
            {
              "id": "5efb1859110533727a82c624",
              "text": "一般",
              "color": "#FF7575"
            }
          ],
          "is_removable": 1,
          "is_name_editable": 1,
          "is_options_editable": 1,
          "select_all_level": false,
          "display_all_level": false,
          "display_separator": null
        }
      },
      {
        "name": "响应示例（cascade_select）：",
        "type": "json",
        "value": {
          "id": "jiliandanxuan",
          "url": "https://{rest_api_root}/v2/pjm/workitem_properties/jiliandanxuan",
          "name": "级联单选-update",
          "type": "cascade_select",
          "options": [
            {
              "id": "64b9f741eec7fd94e63b411e",
              "text": "父-update",
              "color": "#FF7575"
            },
            {
              "id": "64b9f741eec7fd94e63b411f",
              "text": "子-update",
              "color": "#FF7575",
              "parent_id": "64b9f741eec7fd94e63b411e"
            },
            {
              "id": "64b9f741eec7fd94e63b411g",
              "text": "子-create",
              "color": "#FF7575",
              "parent_id": "64b9f741eec7fd94e63b411f"
            }
          ],
          "is_removable": 1,
          "is_name_editable": 1,
          "is_options_editable": 1,
          "select_all_level": false,
          "display_all_level": false,
          "display_separator": "/"
        }
      }
    ]
  }
}
