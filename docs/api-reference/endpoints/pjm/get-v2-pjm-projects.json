  "request": {
    "query": {
      "schema": {
        "type": "object",
        "properties": {
          "scope_type": {
            "type": "string",
            "description": "项目的所属类型。允许值分别表示企业可见和团队可见。",
            "enum": [
              "organization",
              "user_group"
            ]
          },
          "scope_id": {
            "type": "string",
            "description": "项目的所属 id。仅支持团队的 id。"
          },
          "keywords": {
            "type": "string",
            "description": "关键字。只支持 `name` 关键字搜索。"
          },
          "member_type": {
            "type": "string",
            "description": "项目成员的类型。`member_type` 和 `member_id` 必须同时存在。",
            "enum": [
              "user",
              "user_group"
            ]
          },
          "member_id": {
            "type": "string",
            "description": "项目成员的 id。值为企业成员或团队的 id。`member_id` 和 `member_type` 必须同时存在。"
          },
          "template_type": {
            "type": "string",
            "description": "项目类型。",
            "enum": [
              "scrum",
              "kanban",
              "waterfall",
              "hybrid"
            ]
          },
          "created_between": {
            "type": "string",
            "description": "创建时间介于的时间范围，通过','分割起始时间。"
          },
          "updated_between": {
            "type": "string",
            "description": "更新时间介于的时间范围，通过','分割起始时间。"
          },
          "include_deleted": {
            "type": "boolean",
            "description": "是否查询已删除的项目。该值默认为 `false`。"
          },
          "include_archived": {
            "type": "boolean",
            "description": "是否查询已归档的项目。该值默认为 `false`。"
          }
        }
      }
    }
  },
